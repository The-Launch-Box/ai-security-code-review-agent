# .env.example
# Choose your preferred provider: anthropic, openai, google, or ollama
LLM_PROVIDER=ollama

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# GitHub Token (Optional, for scanning private repos or posting PR comments)
GITHUB_TOKEN=your_github_token_here

# Local Models (Optional)
OLLAMA_MODEL=llama3
